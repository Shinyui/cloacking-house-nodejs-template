CLOAKING_LABEL=replace-with-your-cloaking-house-label
CLOAKING_API_URL=https://cloakit.house/api/v1/check
# socket: direct connections; x-real-ip: a proxy that overwrites X-Real-IP.
IP_SOURCE=socket
PORT=3000

# Meta Conversions API (optional; keep disabled until all values are configured).
META_CAPI_ENABLED=false
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v24.0
# Optional Graph API host override for local/mock verification.
META_API_BASE_URL=https://graph.facebook.com
PUBLIC_ORIGIN=https://example.com
META_DEFAULT_CURRENCY=
META_DEFAULT_PHONE_REGION=
META_TEST_EVENT_CODE=
META_CAPI_TIMEOUT_MS=3000
META_CAPI_RETRIES=1
META_CAPI_RATE_LIMIT=60
